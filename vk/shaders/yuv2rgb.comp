#version 450
// I420 → XRGB8888 compute kernel (one invocation per output pixel).
//
// Colour math: integer BT.601 studio-swing, the identical derivation to the CPU
// reference in wayland/src/convert.rs — see vk/REFERENCES.md:
//   Rec. ITU-R BT.601-7 (03/2011) §2.5.1: Kr = 0.299, Kb = 0.114 (Kg = 1-Kr-Kb);
//   §3.5: Y' spans 16..235 (219 steps), Cb/Cr span ±112 around 128.
// Folding the range expansion into the matrix and scaling by 256:
//   298 = round(256*255/219), 409 = round(256*(255/224)*2*(1-Kr)),
//   516 = round(256*(255/224)*2*(1-Kb)), G-row 208/100 via Kg.
// GLSL `>>` on a signed int is an arithmetic shift (GLSL 4.50 §5.9), matching the
// Rust `i32 >>` in the CPU path — the two must agree exactly (tested).
//
// Output pixel word: 0x00RRGGBB in a native u32 — little-endian bytes [B, G, R, X],
// which is both wl_shm XRGB8888 and DRM_FORMAT_XRGB8888 ('XR24'). X is set to 0xFF
// like the CPU path (harmless for XRGB, correct if reused as ARGB).
//
// Chroma geometry rounds *up* (ceil(w/2) x ceil(h/2)) — streamcraft-video's
// convention, so odd dimensions still have a covering chroma sample.

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PC {
    uint width;
    uint height;
} pc;

// Binding 0: the packed I420 planes (Y then Cb then Cr), bytes packed 4-per-u32 LE.
layout(std430, binding = 0) readonly buffer Planes { uint planes[]; };
// Binding 1: the output framebuffer, one XRGB8888 u32 per pixel, row stride == width.
layout(std430, binding = 1) writeonly buffer Pixels { uint pixels[]; };

uint plane_byte(uint i) {
    return (planes[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    uint cw = (pc.width + 1u) / 2u;
    uint ch = (pc.height + 1u) / 2u;
    uint ysize = pc.width * pc.height;
    uint ci = (y / 2u) * cw + (x / 2u);

    int c = int(plane_byte(y * pc.width + x)) - 16;
    int d = int(plane_byte(ysize + ci)) - 128;
    int e = int(plane_byte(ysize + cw * ch + ci)) - 128;

    int r = clamp((298 * c + 409 * e + 128) >> 8, 0, 255);
    int g = clamp((298 * c - 100 * d - 208 * e + 128) >> 8, 0, 255);
    int b = clamp((298 * c + 516 * d + 128) >> 8, 0, 255);

    pixels[y * pc.width + x] = uint(b) | (uint(g) << 8) | (uint(r) << 16) | 0xff000000u;
}
